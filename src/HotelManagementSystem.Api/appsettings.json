{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtOptions": {
  "Issuer": "HotelManagementSystem",
  "Audience": "HotelManagementSystem.Clients",
  "AccessTokenMinutes": 15,
  "RefreshTokenDays": 30
},
  "ConnectionStrings": {
  "DefaultConnection": "Server=localhost;Database=HotelManagementSystem;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Resend": {
    "ConfirmationUrlFormat":"https://localhost:5173/confirm-email?email={0}&token={1}",
    "PasswordResetUrlFormat": "https://localhost:5173/reset-password?email={0}&token={1}"
  },
  "GmailEmail": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromEmail": "",
    "Username": "",
    "AppPassword": ""
  },

  "AllowedHosts": "*"
}
